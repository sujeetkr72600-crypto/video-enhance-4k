
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Video Enhance 4K - AI Video Enhancer</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <header class="navbar">
    <div class="logo">🎬 Video Enhance <span>4K</span></div>
    <div class="tag">AI POWERED</div>
  </header>

  <main class="container">

    <section class="hero">
      <p class="small-title">NEXT GENERATION VIDEO ENHANCEMENT</p>
      <h1>Make Your Videos<br>
        <span>Look Stunning.</span>
      </h1>
      <p class="description">
        Transform low-quality videos into beautiful
        high-resolution videos with AI technology.
      </p>
    </section>

    <section class="upload-card">

      <h2>Upload Your Video</h2>
      <p class="muted">Select a video from your device</p>

      <label for="videoFile" class="upload-area">
        <div class="upload-icon">☁️</div>
        <h3>Choose Your Video</h3>
        <p>MP4, MOV or WEBM</p>
        <span class="choose-btn">Browse Video</span>
      </label>

      <input
        type="file"
        id="videoFile"
        accept="video/mp4,video/quicktime,video/webm"
        hidden
      >

      <div id="videoInfo" class="video-info">
        No video selected
      </div>

      <video id="videoPreview" controls hidden></video>

      <h3 class="quality-heading">Select Output Quality</h3>

      <div class="quality-options">
        <button class="quality active" data-quality="1080p">
          1080p
        </button>
        <button class="quality" data-quality="2K">
          2K
        </button>
        <button class="quality" data-quality="4K">
          4K
        </button>
      </div>

      <button id="enhanceBtn" class="enhance-btn">
        ✨ Enhance Video with AI
      </button>

      <p id="status" class="status">
        Upload a video to get started.
      </p>

    </section>

    <section class="features">
      <h2>Why Choose Us?</h2>
      <div class="feature">
        <span>⚡</span>
        <div>
          <h3>AI Enhancement</h3>
          <p>Improve video details and clarity.</p>
        </div>
      </div>

      <div class="feature">
        <span>🎥</span>
        <div>
          <h3>High Resolution</h3>
          <p>Choose 1080p, 2K or 4K output.</p>
        </div>
      </div>

      <div class="feature">
        <span>⬇️</span>
        <div>
          <h3>Easy Download</h3>
          <p>Download your enhanced video.</p>
        </div>
      </div>
    </section>

  </main>

  <footer>
    © 2026 Video Enhance 4K. All Rights Reserved.
  </footer>

  <script src="script.js"></script>
</body>
</html>
